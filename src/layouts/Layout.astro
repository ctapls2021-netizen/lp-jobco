---
import '../styles/natural-stone.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Paving Contractors for Bay Area Homes & Commercial Properties | JOBCO Paving",
  description = "From driveways, patios, and pavers to parking lots, asphalt repair, striping, concrete, and drainage work, we provide the paving services your property needs."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="w-mod-js w-mod-ix">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/Jobco-favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Lato:ital,wght@0,300;0,400;0,700;1,400&family=Marcellus&display=swap" rel="stylesheet" />

    <!-- Stylesheets from Natural Stone Template -->
    <link rel="stylesheet" href="/assets/natural-stone/scl-dev.webflow.shared.b948b5259.min.css" />
    <link rel="stylesheet" href="/assets/natural-stone/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/assets/natural-stone/nice-select2.css" />
  </head>
  <body class="m-body m-body_home">
    <div class="m-body__inner m-body__inner_colored-nav">
      <slot />
    </div>

    <!-- Core Scripts -->
    <script is:inline src="/assets/natural-stone/jquery-3.5.1.min.dc5e7f18c8.js"></script>
    <script is:inline src="/assets/natural-stone/swiper-bundle.min(1).js"></script>
    <script is:inline src="/assets/natural-stone/webflow.29243517.81f421e87fbb3a65.js"></script>

    <!-- Swiper and Interactive Helpers -->
    <script is:inline>
      function switcherSwiper(breakpoint, classEl, option) {
        if (typeof matchMedia === 'undefined') return;
        const bp = matchMedia(breakpoint);
        let swiper;

        function checkChangeSizeViewport() {
          if (bp.matches) enable();
          else disable();
        }
        const enable = () => {
          if (typeof Swiper !== 'undefined') {
            swiper = new Swiper(classEl, option);
          }
        };
        const disable = () => {
          if (swiper !== undefined) swiper.destroy(true, true);
        };
        checkChangeSizeViewport();
        bp.addEventListener('change', checkChangeSizeViewport);
      }

      document.addEventListener('DOMContentLoaded', () => {
        // Initialize Swipers
        switcherSwiper('(max-width: 767px)', '.s-why-choose__wr-list', {
          loop: true,
          slidesPerView: 1,
          autoplay: { delay: 3000 },
          pagination: { el: '.swiper-pagination', type: 'bullets' }
        });

        const option = {
          loop: true,
          slidesPerView: 1.5,
          spaceBetween: 16
        };
        switcherSwiper('(max-width: 992px)', '.swiper-nature-prod', option);
        switcherSwiper('(max-width: 767px)', '.swiper-nature-pavers', option);
        switcherSwiper('(max-width: 767px)', '.swiper-nature-prods', option);

        // Testimonials slider
        if (document.querySelector('.s-what-say') && typeof Swiper !== 'undefined') {
          new Swiper('.s-what-say', {
            slidesPerView: 1,
            spaceBetween: 24,
            pagination: { el: '.s-what-say__pagination', clickable: true },
            breakpoints: {
              768: { slidesPerView: 2 },
              1024: { slidesPerView: 3 }
            }
          });
        }
      });
    </script>
  </body>
</html>
