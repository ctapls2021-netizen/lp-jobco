---
import '../styles/global.css';

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/Jobco-logo-header.svg" />
    <title>Thank You for Reaching Out | JOBCO Paving</title>
    <meta name="description" content="Thank you for requesting an estimate from JOBCO Paving. Our paving specialists will review your project and get in touch promptly." />
    <meta name="robots" content="noindex, follow" />
    
    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Marcellus&display=swap" rel="stylesheet" />
  </head>
  <body class="thank-you-body">
    <!-- Background overlay with subtle paving photo & blur -->
    <div class="thank-you-bg">
      <img src="/assets/hero-driveway.jpg" alt="Background" class="bg-img" />
      <div class="bg-overlay"></div>
    </div>

    <main class="thank-you-container">
      <!-- TOP BLOCK: Official Logo -->
      <header class="thank-you-header">
        <a href="/" class="brand-link" aria-label="JOBCO Paving Home">
          <img src="/assets/Jobco-logo-header.svg" alt="JOBCO Paving" class="brand-logo" width="220" height="56" />
        </a>
      </header>

      <!-- CENTER BLOCK: Confirmation Card (100% Typographic, ZERO Emojis/Icons) -->
      <section class="thank-you-card">
        <span class="eyebrow thank-you-eyebrow">REQUEST RECEIVED</span>
        <h1 class="thank-you-title">Thank You for Reaching Out</h1>
        <div class="divider-line"></div>
        <p class="thank-you-message">
          We have received your paving project request. Our Bay Area estimators are reviewing your details and will contact you promptly with your free, detailed proposal.
        </p>
        <p class="thank-you-submessage">
          Need immediate assistance or have an urgent scheduling requirement? Call our local team directly:
        </p>

        <div class="thank-you-actions">
          <a href="tel:5105665484" class="btn btn-primary thank-you-call-btn">
            CALL (510) 566-5484
          </a>
          <a href="/" class="return-home-link">
            Return to Homepage
          </a>
        </div>
      </section>

      <!-- BOTTOM BLOCK: Footer Info -->
      <footer class="thank-you-footer">
        <p class="footer-legal">
          &copy; {currentYear} JOBCO Paving. Bay Area Paving Contractors &bull; Licensed, Bonded & Insured &bull; San Francisco Bay Area, CA
        </p>
      </footer>
    </main>

    <style>
      .thank-you-body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        min-height: 100dvh;
        height: 100vh;
        height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        background-color: var(--color-primary);
        color: #FFFFFF;
        overflow-y: auto;
      }

      .thank-you-bg {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
      }

      .bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.25) contrast(1.2);
      }

      .bg-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, rgba(10, 55, 75, 0.92) 0%, rgba(6, 35, 48, 0.98) 100%);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }

      .thank-you-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 780px;
        min-height: 100vh;
        min-height: 100dvh;
        margin: 0 auto;
        padding: 40px 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        box-sizing: border-box;
      }

      .thank-you-header {
        width: 100%;
        display: flex;
        justify-content: center;
        padding-bottom: 20px;
      }

      .brand-logo {
        height: 52px;
        width: auto;
      }

      .thank-you-card {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-top: 4px solid var(--color-accent);
        padding: clamp(32px, 5vw, 54px) clamp(24px, 5vw, 48px);
        text-align: center;
        width: 100%;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
      }

      .thank-you-eyebrow {
        margin-bottom: 12px;
        color: var(--color-accent);
      }

      .thank-you-title {
        font-family: var(--font-heading);
        font-size: clamp(28px, 4vw, 42px);
        color: #FFFFFF;
        line-height: 1.2;
        margin-bottom: 20px;
      }

      .divider-line {
        width: 80px;
        height: 3px;
        background-color: var(--color-accent);
        margin: 0 auto 24px auto;
      }

      .thank-you-message {
        font-size: clamp(16px, 2vw, 18px);
        line-height: 1.65;
        color: rgba(255, 255, 255, 0.95);
        margin-bottom: 14px;
      }

      .thank-you-submessage {
        font-size: 15px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 32px;
      }

      .thank-you-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }

      .thank-you-call-btn {
        width: 100%;
        max-width: 340px;
        padding: 16px 32px;
        font-size: 16px;
      }

      .return-home-link {
        font-family: var(--font-body);
        font-size: 15px;
        color: rgba(255, 255, 255, 0.7);
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
      }

      .return-home-link:hover {
        color: var(--color-accent);
      }

      .thank-you-footer {
        width: 100%;
        text-align: center;
        padding-top: 20px;
      }

      .footer-legal {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.55);
        line-height: 1.5;
      }

      @media (max-height: 750px) {
        .thank-you-container {
          padding: 24px 16px;
        }

        .thank-you-card {
          padding: 24px 20px;
        }

        .thank-you-title {
          font-size: 26px;
          margin-bottom: 12px;
        }

        .divider-line {
          margin-bottom: 16px;
        }

        .thank-you-submessage {
          margin-bottom: 20px;
        }
      }
    </style>
  </body>
</html>
