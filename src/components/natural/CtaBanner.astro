---
---

<section class="s-call-us-banner" style="position: relative; padding: 100px 0; background-color: #0A374B; color: #FFFFFF; overflow: hidden; text-align: center;">
  <!-- Background Image with Overlay -->
  <div style="position: absolute; inset: 0; z-index: 1;">
    <img 
      src="/assets/jobco-photos/Jobco-Company-2.jpg" 
      alt="JOBCO Paving Project" 
      loading="lazy" 
      style="width: 100%; height: 100%; object-fit: cover;"
    />
  </div>
  <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10, 55, 75, 0.2) 0%, rgba(6, 35, 48, 0.2) 100%); z-index: 2;"></div>

  <div class="m-container s-call-us-banner__container w-container" style="position: relative; z-index: 5; max-width: 900px; margin: 0 auto; padding: 0 20px;">
    <div class="m-inner s-call-us-banner__inner">
      <span class="subheadline" style="display: block; font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em; color: #27A8E1; font-weight: 700; margin-bottom: 12px;">
        START YOUR PROJECT
      </span>
      <h2 class="m-second-heading s-call-us-banner__heading" style="font-size: clamp(2.2rem, 4vw, 3.2rem); color: #FFFFFF; margin: 0 0 20px 0; line-height: 1.2;">
        Ready to Get Your Paving Project Started?
      </h2>
      <p style="font-size: 18px; line-height: 1.65; color: rgba(244, 247, 249, 0.9); margin: 0 auto 36px auto; max-width: 780px;">
        Whether the work is for your home or commercial property, get your free estimate for paving, repair, resurfacing, sealcoating, concrete, pavers, striping, drainage, maintenance, or related surface work.
      </p>

      <!-- Action Button -->
      <div style="margin-bottom: 24px;">
        <a href="#lead-form" class="btn-jobco btn-jobco-primary" style="padding: 18px 40px; font-size: 16px;">
          Get Your Free Estimate
        </a>
      </div>

      <!-- Phone line -->
      <p style="margin: 0; font-size: 16px; color: rgba(244, 247, 249, 0.9);">
        Prefer to speak with us now? Call <a href="tel:5105665484" style="color: #27A8E1; font-weight: 700; text-decoration: underline;">(510) 566-5484</a>.
      </p>
    </div>
  </div>
</section>

<style>
  @media (max-width: 991px) {
    .s-call-us-banner {
      padding-top: 50px !important;
      padding-bottom: 50px !important;
    }
  }
</style>
