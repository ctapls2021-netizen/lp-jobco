---
import AnimatedButton from '../AnimatedButton.astro';
const steps = [
  {
    num: "01",
    title: "Choose Your Project Type",
    text: "Select Home or Commercial Property and tell us what needs attention."
  },
  {
    num: "02",
    title: "We Review Your Request",
    text: "We review the project details, ZIP code, and requested service so we can discuss the right next step for the property."
  },
  {
    num: "03",
    title: "Get a Clear Estimate",
    text: "We assess the project requirements and provide a detailed proposal with costs and timelines based on the work involved."
  }
];
---

<section id="how-it-works" class="s-why-choose" style="padding: 100px 0; background-color: #FFFFFF; overflow: hidden; max-width: 100vw;">
  <div class="m-container w-container" style="max-width: 1280px; margin: 0 auto; padding: 0 20px;">
    <!-- Section Heading -->
    <div style="text-align: center; max-width: 800px; margin: 0 auto 50px auto;">
      <span class="subheadline" style="display: block; font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em; color: #27A8E1; font-weight: 700; margin-bottom: 8px;">
        STREAMLINED PROCESS
      </span>
      <h2 class="m-first-heading s-why-choose__heading" style="font-size: clamp(2rem, 3.5vw, 3rem); color: #0A374B; margin: 0; opacity: 1;">
        Get Your Paving Project Moving In Three Simple Steps.
      </h2>
    </div>

    <!-- 3 Steps Swiper -->
    <div class="swiper steps-swiper" style="margin-bottom: 50px; max-width: 100vw; overflow: hidden;">
      <div class="swiper-wrapper steps-wrapper">
        {steps.map(step => (
          <div class="swiper-slide steps-slide jobco-step-card" style="box-sizing: border-box; text-align: center;">
            <div style="font-family: var(--font-secondary); font-size: 36px; font-weight: 700; color: #27A8E1; margin-bottom: 16px; line-height: 1;">
              Step {step.num}
            </div>
            <h3 class="m-fifth-heading" style="font-size: 22px; color: #0A374B; margin: 0 0 12px 0;">
              {step.title}
            </h3>
            <p style="font-size: 16px; color: #475569; line-height: 1.6; margin: 0;">
              {step.text}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA Button -->
    <div class="hiw-cta-wrap" style="text-align: center;">
      <AnimatedButton text="Get Your Free Estimate" href="#lead-form" />
    </div>
  </div>
</section>

<style>
  @media (max-width: 991px) {
    .s-why-choose {
      padding-top: 50px !important;
      padding-bottom: 50px !important;
    }
    .hiw-cta-wrap {
      margin-top: 30px !important;
    }
    .steps-swiper {
      width: 100%;
      overflow: hidden !important;
    }
    .steps-slide {
      width: 100%;
      box-sizing: border-box;
    }
  }
  @media (min-width: 992px) {
    .steps-wrapper {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
    .steps-slide {
      width: 100% !important;
      margin: 0 !important;
    }
    .steps-swiper {
      overflow: visible !important;
    }
  }
  .jobco-step-card {
    position: relative;
    background: #F4F7F9;
    border: 1px solid #E2E8F0;
    padding: 36px 28px;
    box-sizing: border-box;
    cursor: default;
  }
  
  /* Draw border animation lines */
  .jobco-step-card::before,
  .jobco-step-card::after {
    content: "";
    position: absolute;
    width: 0;
    height: 0;
    box-sizing: border-box;
    border: 2px solid transparent;
    pointer-events: none;
    z-index: 5;
  }

  /* Start positions */
  .jobco-step-card::before {
    top: -1px;
    left: -1px;
    transition: width 0.15s ease-out 0.45s, height 0.15s ease-out 0.3s;
  }
  .jobco-step-card::after {
    bottom: -1px;
    right: -1px;
    transition: border-color 0s ease-out 0.3s, width 0.15s ease-out 0.15s, height 0.15s ease-out 0s;
  }

  /* Hover state: Draws Top -> Right -> Bottom -> Left */
  .jobco-step-card:hover::before {
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    border-top-color: #27A8E1;
    border-right-color: #27A8E1;
    transition: width 0.15s ease-out, height 0.15s ease-out 0.15s;
  }
  
  .jobco-step-card:hover::after {
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    border-bottom-color: #27A8E1;
    border-left-color: #27A8E1;
    transition: border-color 0s ease-out 0.3s, width 0.15s ease-out 0.3s, height 0.15s ease-out 0.45s;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    let stepsSwiper;
    
    function initStepsSwiper() {
      if (typeof Swiper === 'undefined') {
        setTimeout(initStepsSwiper, 100);
        return;
      }
      
      if (window.innerWidth < 992 && !stepsSwiper) {
        stepsSwiper = new Swiper('.steps-swiper', {
          slidesPerView: 1,
          spaceBetween: 20,
          loop: true,
          autoplay: {
            delay: 3500,
            disableOnInteraction: false,
          },
          allowTouchMove: true
        });
      } else if (window.innerWidth >= 992 && stepsSwiper) {
        stepsSwiper.destroy(true, true);
        stepsSwiper = undefined;
      }
    }
    
    initStepsSwiper();
    window.addEventListener('resize', initStepsSwiper);
  });
</script>
