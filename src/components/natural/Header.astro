<header id="comradeHeader" class="c-nav sticky" style="position: sticky; top: 0; z-index: 1000; background-color: #0A374B; border-bottom: 1px solid rgba(255,255,255,0.12);">
  <!-- Main Navigation Bar -->
  <div class="c-nav__wr-nav" style="padding: 18px 0;">
    <div class="m-container c-nav__container w-container">
      <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
      
      <!-- Logo -->
      <a href="/" style="display: flex; align-items: center; text-decoration: none;">
        <img 
          src="/assets/Jobco-logo-header.svg" 
          alt="JOBCO Paving" 
          style="height: 48px; width: auto; object-fit: contain;" 
        />
      </a>

      <!-- Action Buttons (Phone & CTA) -->
      <div style="display: flex; align-items: center; gap: 24px;">
        <a 
          href="tel:5105665484" 
          class="header-phone-link"
          style="display: inline-flex; align-items: center; gap: 8px; color: #FFFFFF; text-decoration: none; font-weight: 700; font-size: 16px; transition: color 0.2s;"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="#27A8E1">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>Call (510) 566-5484</span>
        </a>

        <a 
          href="#lead-form" 
          class="btn-jobco btn-jobco-primary header-cta-btn"
          style="padding: 14px 28px; font-size: 15px;"
        >
          Get Your Free Estimate
        </a>
      </div>
      
      </div>
    </div>
  </div>
</header>

<style>
  @media (max-width: 640px) {
    .header-phone-link span {
      display: none;
    }
    .header-cta-btn {
      padding: 12px 18px !important;
      font-size: 13px !important;
    }
  }
</style>
