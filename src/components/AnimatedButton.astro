---
interface Props {
  text: string;
  href?: string;
  classes?: string;
  target?: string;
  isSubmit?: boolean;
}

const { text, href, classes = "", target = "_self", isSubmit = false } = Astro.props;
---

{isSubmit ? (
  <button type="submit" class={`animated-btn ${classes}`}>
    <span class="animated-btn__text">{text}</span>
    <div class="animated-btn__icon-wrapper">
      <svg class="animated-btn__icon-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17L17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
      <svg class="animated-btn__icon-2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17L17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
    </div>
  </button>
) : (
  <a href={href} target={target} class={`animated-btn ${classes}`}>
    <span class="animated-btn__text">{text}</span>
    <div class="animated-btn__icon-wrapper">
      <svg class="animated-btn__icon-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17L17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
      <svg class="animated-btn__icon-2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17L17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
    </div>
  </a>
)}
